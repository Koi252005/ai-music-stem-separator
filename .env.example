# ── Compute device ────────────────────────────────────────────────────────────
# auto  = use CUDA if available, else CPU
# cpu   = force CPU
# cuda  = force GPU (will error if no CUDA-capable device)
DEFAULT_DEVICE=auto

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200

# ── Python interpreter ────────────────────────────────────────────────────────
# Override if using a different venv for the models.
# Defaults to the interpreter running the server (sys.executable).
# PYTHON_EXECUTABLE=C:\path\to\venv\Scripts\python.exe

# ── Server settings ───────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
